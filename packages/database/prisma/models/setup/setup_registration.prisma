model Setup_Registration {
  id String @id @default(uuid(7)) @db.Uuid

  setup_id Int @unique

  organization_name String @db.VarChar(150)

  f_name String @db.VarChar(100)
  l_name String @db.VarChar(100)

  email     String @db.VarChar(254)
  pass_hash String @db.VarChar(255)

  email_token_hash       String?   @unique @db.Char(64)
  email_token_expires_at DateTime? @db.Timestamptz(3)

  email_verified_at DateTime? @db.Timestamptz(3)

  expires_at     DateTime @db.Timestamptz(3)
  email_attempts Int      @default(0)

  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  setup Installation_Setup @relation(fields: [setup_id], references: [id], onDelete: Restrict)

  @@map("setup_registration")
}
