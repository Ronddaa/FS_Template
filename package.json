{
  "name": "@crm/root",
  "version": "1.0.2",
  "private": true,
  "description": "",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@crm/crm-web",
    "dev:api": "turbo run dev --filter=@crm/crm-api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "@ronddaa",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.9"
  }
}