model User_Session {
  id                 String    @id @default(uuid(7)) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String    @unique @db.Char(64)
  user_agent         String?   @db.VarChar(512)
  ip_address         String?   @db.VarChar(45)
  last_used_at       DateTime? @db.Timestamptz(3)
  expires_at         DateTime  @db.Timestamptz(3)
  revoked_at         DateTime? @db.Timestamptz(3)
  revoked_reason     String?   @db.VarChar(100)

  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])
  @@index([user_id, revoked_at])
  @@index([expires_at])
  @@map("user_sessions")
}
